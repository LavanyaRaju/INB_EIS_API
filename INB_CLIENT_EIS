public class YonoEisClient {
	
	public static void main(String args[]){
		YonoEisClient clien=new YonoEisClient();
		clien.cancelYonoTxn("FXYON202503281215050");
	}
	
	
	public void cancelYonoTxn(String refNumber){
		
		if(null!=refNumber){
			try {
			EISYonoRequest eisYonoRequest=new EISYonoRequest();
			eisYonoRequest.setTransactionReferenceID(refNumber);
			String encryptedStr = CommonUtil.encrypt(CommonUtil.objectToJson(eisYonoRequest));
		   EisEncReq request=new EisEncReq();
		   request.setEisEncReq(encryptedStr);
		   Map<String, String> resp=callServiceApi(FXOUTConstants.SERVER_URI+ FXOUTConstants.CANCEL_TXN, request);
			} catch (IOException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
	}
	public Map<String, String> callServiceApi(String urlhit, EisEncReq request) throws IOException {
		HttpURLConnection conn = null;
		OutputStream os = null;
		Map<String, String> response = null;
		try {
			URL url = new URL(urlhit);
			conn = (HttpURLConnection) url.openConnection();
			conn.setDoOutput(true);
			conn.setRequestMethod("POST");
			conn.setRequestProperty("Content-Type", "application/json");
			os = conn.getOutputStream();
			// Convert request object in json format
			ObjectMapper objectMapper = new ObjectMapper();
			String req = objectMapper.writeValueAsString(request);
			os.write(req.getBytes());
			os.flush();
			os.close();

			int responseCode = conn.getResponseCode();
			System.out.println("POST Response Code :: " + responseCode);

			if (responseCode == HttpURLConnection.HTTP_OK) { // success
				BufferedReader in = new BufferedReader(new InputStreamReader(conn.getInputStream()));
				String inputLine;
				StringBuffer responceEncrypted = new StringBuffer();
				while ((inputLine = in.readLine()) != null) {
					responceEncrypted.append(inputLine);
				}
				in.close();
				System.out.println("Encrypted Response: " + responceEncrypted);

				if (responceEncrypted != null && !responceEncrypted.equals("")) {

					EisEncResponse resp = objectMapper.readValue(responceEncrypted.toString(), EisEncResponse.class);
					String deeypt = CommonUtil.decrypt(resp.getEisEncResp().toString());
					System.out.println(deeypt);
					response = (Map<String, String>) CommonUtil.jsonToEndpointRequest(
							CommonUtil.decrypt(resp.getEisEncResp().toString()), new HashMap<String, String>());

				} else {
					response = new HashMap<String, String>();
					response.put(ErrorCode.EMPTYRESPONCE.getStatusCode(), ErrorCode.EMPTYRESPONCE.getMessage());
					System.out.println("no responce from fxout ");
				}
			} else {
				response = new HashMap<String, String>();
				response.put(ErrorCode.FXOUTDOWN.getStatusCode(), ErrorCode.FXOUTDOWN.getMessage());
			}
		} catch (MalformedURLException e) {
			response = new HashMap<String, String>();
			response.put(ErrorCode.FXOUTDOWN.getStatusCode(), ErrorCode.FXOUTDOWN.getMessage());
			System.out.println("MalformedURLException POST request not worked");
			e.printStackTrace();
		} catch (IOException e) {
			response = new HashMap<String, String>();
			response.put(ErrorCode.FXOUTDOWN.getStatusCode(), ErrorCode.FXOUTDOWN.getMessage());
			System.out.println("IOException POST request not worked");
			e.printStackTrace();
		} catch (Exception ex) {
			ex.printStackTrace();
		} finally {
			try {
				if (os != null) {
					os.flush();
					os.close();
				}
				if (conn != null)
					conn.disconnect();
			} catch (IOException e) {
				e.printStackTrace();
			}
		}
		return response;
	}

}
