package com.sbi.fxout.util;

import java.util.Set;
import java.util.StringTokenizer;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.sbi.fxout.authentication.EncryptionDecryption;

public class CommonUtil {

	public static String objectToJson(Object object) {
		ObjectMapper mapper = new ObjectMapper();
		String jsonInString = null;

		try {
			jsonInString = mapper.writeValueAsString(object).toString();
			System.out.println("Json Request:" + jsonInString);
		} catch (Exception e) {
			e.printStackTrace();
		}
		return jsonInString;
	}

	public static Object jsonToEndpointRequest(String jsonInString,
			Object object) {
		ObjectMapper mapper = new ObjectMapper();

		try {
			object = mapper.readValue(jsonInString, object.getClass());
			System.out.println("Json Response:" + jsonInString);
		} catch (Exception e) {
			e.printStackTrace();
		}
		return object;
	}

	/**
	 * @param encData
	 * @return
	 */
	public static String decrypt(String data) {
		return EncryptionDecryption.decrypt(data);
	}

	/**
	 * @param data
	 * @return
	 */
	public static String encrypt(String data) {
		return EncryptionDecryption.encrypt(data);
	}

	/**
	 * It converts comma separated string value to a list for unique values
	 * Values stored in setOfuniqValue
	 * 
	 * @param commaSepValue
	 * @param setOfuniqValue
	 * @return void
	 */
	public static void commaSeparatedStrToUniqList(String commaSepValue,
			Set<String> setOfuniqValue) {
		StringTokenizer st = new StringTokenizer(commaSepValue, ",");
		while (st.hasMoreTokens())
			setOfuniqValue.add(st.nextToken());
	}

}
