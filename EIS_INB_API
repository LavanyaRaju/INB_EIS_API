@Repository
public class EisYonoDaoServiceImpl implements EisYonoDaoService {
	public final static Logger logger =  LogManager.getLogger(EisYonoDaoServiceImpl.class);
	
	@Autowired
	private JdbcTemplate jdbcTemplate;

	@Override
	public int cancelTxn(String RefNumber)throws SQLException {
		// TODO Auto-generated method stub
		logger.debug("cancelTxn start {}",RefNumber);
		int count = 0;
		 Object[] params= {Constants.STATUS_CANCELLED,Constants.STATUS_CANCELLED,RefNumber,"wait_p_cred","l1_approved"};
		count = jdbcTemplate.update(SQLConstant.CANCEL_YONO_TXN, params);
		logger.debug("cancelTxn RefNumber  end {}",RefNumber+"and count "+count);
		return count;
	}

	@Override
	public int getTxnForCancel(String RefNumber) throws SQLException{
		// TODO Auto-generated method stub
		int count = 0;
		 Object[] params= {RefNumber};
		count = jdbcTemplate.queryForObject(SQLConstant.GET_YONO_TXN_FOR_CANCEL, params,Integer.class);
		
		return count;
	}
	
	@Override
	public YonoTxnModel getTxnStatusAndCount(String RefNumber) throws SQLException{
		// TODO Auto-generated method stub
		logger.debug("getTxnStatusAndCount start {}",RefNumber);
		 Object[] params= {RefNumber};
		 YonoTxnModel modelData = (YonoTxnModel) jdbcTemplate.queryForObject(SQLConstant.GET_YONO_TXN_FOR_STATUS_COUNT, params,new CancelYonoTxnRowMapper());
		 logger.debug("getTxnStatusAndCount end {}",RefNumber);
		return modelData;
	}
	
	
	
	class CancelYonoTxnRowMapper implements RowMapper {

		public Object mapRow(ResultSet rs, int index) throws SQLException {
			YonoTxnModel model=new YonoTxnModel();
			model.setCount(rs.getInt("count"));
			model.setTxnStatus(rs.getString("status"));
			model.setTxnPstatus(rs.getString("present_status"));
			return model;
		}

	}
	
	class Mt103RowMapper implements RowMapper {

		public Object mapRow(ResultSet rs, int index) throws SQLException {
			YonoTxnModel model=new YonoTxnModel();
				model.setmT103msg(rs.getString("mt103Msg"));
		
			return model;
		}

	}



	@Override
	public YonoTxnModel fetchMT103MsgByRefNum(String RefNumber) throws SQLException {
		// TODO Auto-generated method stub
		logger.debug("getTxnStatusAndCount start {}",RefNumber);
		 YonoTxnModel modelData=null;
		try{
		 Object[] params= {RefNumber};
//		 modelData = (YonoTxnModel) jdbcTemplate.queryForObject(SQLConstant.GET_MT103MSG, params,new Mt103RowMapper());
		 List<YonoTxnModel>modelDatalist = jdbcTemplate.query(SQLConstant.GET_MT103MSG, params,new Mt103RowMapper());
		 logger.debug("getTxnStatusAndCount end {}",RefNumber);
		 if(modelDatalist.size()>0){
			 modelData= modelDatalist.get(0);
		 }
		}catch(Exception ex){
			System.out.println(ex.getMessage());
			ex.printStackTrace();
		}
		return modelData;
	}

	@Override
	public List<TxnHistoryModel> fetchTxnHistory(String cifNumber, String strDate, String endDate) throws SQLException {
		// TODO Auto-generated method stub
		List<TxnHistoryModel>modelDatalist=null;

		Object[] params= {cifNumber,cifNumber,strDate,endDate};
		 modelDatalist = jdbcTemplate.query(SQLConstant.GET_TXN_HISTORY, params,new TxnHistRowMapper());
		return modelDatalist;
	}
	
	class TxnHistRowMapper implements RowMapper {

		public Object mapRow(ResultSet rs, int index) throws SQLException {
			TxnHistoryModel model=new TxnHistoryModel();
			try{
			BeneficiaryBankDetails benBankDet=new BeneficiaryBankDetails();
			model.setReferenceNumber(rs.getString("reference_number"));
			model.setSrNo(rs.getString("SrNo"));
			model.setBeneficiaryName(rs.getString("beneficiary_name"));
			benBankDet.setName(rs.getString("beneficiary_bank_name"));
			benBankDet.setAddress(rs.getString("beneficiary_bank_address"));
			model.setBeneficiaryBankDetails(benBankDet);
			model.setBeneficiaryAccountnumber(rs.getString("beneficiary_account_number"));
			model.setTotalINRAmount(rs.getString("total_inr_amount"));
			model.setCurrency(rs.getString("currency"));
			model.setForeignCurrencyAmount(rs.getString("foreign_currency_amount"));
			model.setTcsAmount(rs.getString("tcs_amount"));
			model.setSbiCharges(rs.getString("sbi_charges"));
			model.setGstAmount(rs.getString("gst_amount"));
			model.setSwiftcode(rs.getString("swift_code"));
			model.setPurposeCode(rs.getString("purpose_code"));
			model.setChargesType(rs.getString("Charges_Type"));
			model.setCreationDate(rs.getString("creation_date"));
			model.setSwiftSentDate(rs.getString("swift_sent_date"));
			model.setUltimateBeneficiaryCountry(rs.getString("ultimate_beneficiary_country"));
			model.setStatusOfPayment(rs.getString("status_of_payment"));
			model.setRemark(rs.getString("Remark"));
			model.setTransactionRemarks(rs.getString("Transaction_Remarks"));
			model.setRemitterAccount(rs.getString("remitter_account"));
			
			}catch (Exception e) {
				logger.debug("Exception in  TxnHistRowMapper for SrNo "+model.getSrNo()+" Refrence Number "+model.getReferenceNumber()+" Exception "+e.getMessage());
			}
			
			
			return model;
		}

	}
}
