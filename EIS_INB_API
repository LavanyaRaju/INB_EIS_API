	@PostMapping(value="/txn/cancel",consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<Object> cancleTxnViaYono(@RequestBody EisEncReq eisEncReq) {
		EISYonoResponse response = new EISYonoResponse();
		EisEncResponse resp = new EisEncResponse();
		String result = null;
		try {
		if (!StringUtils.isEmpty(eisEncReq.getEisEncReq())) {

			ObjectMapper objectMapper=new ObjectMapper();

			String decrReq = EncryptionDecryption.decrypt(eisEncReq.getEisEncReq());

			EISYonoRequest req = null;

			req= objectMapper.readValue(decrReq, EISYonoRequest.class);

			eisYonoService.cancelTxn(req.getTransactionReferenceID(), response);
			result = EncryptionDecryption.encrypt(objectMapper.writeValueAsString(response));
			resp.setEisEncResp(result);
			resp.setStatusCode("200");
			return new ResponseEntity<>(resp, HttpStatus.OK);
		}else{
			return new ResponseEntity<>(resp, HttpStatus.BAD_REQUEST);
		}
		}catch(Exception ex){
			resp.setEisEncResp(result);
			resp.setStatusCode("300");
			return new ResponseEntity<>(resp, HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}

