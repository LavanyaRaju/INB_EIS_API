import com.sbi.fxout.util.Constants;

@Service
public class EisYonoServiceImpl implements EisYonoService {

	public final static Logger logger =  LogManager.getLogger(EisYonoServiceImpl.class);

	@Autowired
	EisYonoDaoService eisYonoDaoService;
	@Override
	public String cancelTxn(String refNumber, EISYonoResponse response) {
		// TODO Auto-generated method stub
		logger.debug("cancelTxn started {}", refNumber);
		String result = null;
		try {
			response.setTransactionReferenceID(refNumber);
			int txnCount = eisYonoDaoService.getTxnForCancel(refNumber);
			logger.debug("cancelTxn txnCount {}", txnCount);
			if (txnCount > 0) {
				YonoTxnModel txnModel = eisYonoDaoService.getTxnStatusAndCount(refNumber);
				logger.debug("cancelTxn txnModel.getTxnStatus() {}", txnModel.getTxnStatus());
				if (!txnModel.getTxnStatus().equalsIgnoreCase(Constants.STATUS_CANCELLED)) {
					int up = eisYonoDaoService.cancelTxn(refNumber);
					if (up == 1) {
						response.setStatusDescription(Constants.TRANSACTION_CANCELED_SUCCESSFULLY);
						response.setStatusCode(Constants.TXN_CANCELED_CODE);
					} else {
						response.setStatusDescription(Constants.TRANSACTION_PROCESSED_AND_CANNOT_BE_CANCELED);
						response.setStatusCode(Constants.TRANSACTION_PROCESSED_CODE);
					}
				} else {
					response.setStatusDescription(Constants.TRANSACTION_ALLREADY_CANCELED);
					response.setStatusCode(Constants.TRANSACTION_PROCESSED_CODE);
				}

			} else {
				response.setStatusDescription(Constants.TRANSACTION_NOT_FOUND);
				response.setStatusCode(Constants.TRANSACTION_NOT_FOUND_CODE);
			}

			result = "Success";
		} catch (SQLException e) {
			logger.debug("SQLException in cancelTxn  {}", e.getMessage());
			response.setStatusDescription("Failed to Cancel Transaction");
			result = "Failed";
		}
		logger.debug("cancelTxn end{}", refNumber);
		return result;
	}
	@Override
	public String getMT103MsgDetailsByRefNo(String refNumber, MT103MsgResponse response) {
		// TODO Auto-generated method stub
		try {
			YonoTxnModel txnModel = eisYonoDaoService.fetchMT103MsgByRefNum(refNumber);
			if(null !=txnModel){
				response.setTransactionReferenceID(refNumber);
				response.setMt103Details(txnModel.getmT103msg());
				response.setStatusDescription(Constants.MT103_DETAILS_FETCHED);
				response.setStatusCode(Constants.DETAILS_FETCHED_CODE);
			}else{
				response.setTransactionReferenceID(refNumber);
				response.setStatusDescription(Constants.MT103_DETAILS_NOT_FOUND);
				response.setStatusCode(Constants.TRANSACTION_NOT_FOUND_CODE);
			}
			
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return null;
	}
	@Override
	public String getTxnHistory(EISYonoRequest eisReq,TxnHistoryResponse response) {
		// TODO Auto-generated method stub
		List<TxnHistoryModel> txnList=null;;
		try {
			String startDate= CommonUtil.formattedDate(eisReq.getStrtDte(),"yyyy-MM-dd", "dd-MMM-yy");
			String endDate= CommonUtil.formattedDate(eisReq.getEndDte(),"yyyy-MM-dd", "dd-MMM-yy");
			txnList=eisYonoDaoService.fetchTxnHistory(eisReq.getCifNumber(), startDate, endDate);
			if(null !=txnList &&txnList.size()>0 ){
				response.setData(txnList);
				response.setStatusCode(Constants.DETAILS_FETCHED_CODE);
				response.setStatusDescription("Transaction History Fetched");
				response.setTotalCount(Integer.toString(txnList.size()));
			}else{
				response.setStatusCode(Constants.TRANSACTION_NOT_FOUND_CODE);
				response.setStatusDescription("Transaction History Not Found");
				response.setTotalCount(Integer.toString(txnList.size()));
			}
			
		} catch (Exception e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
			response.setStatusCode(Constants.DETAILS_FETCHED_CODE);
			response.setStatusDescription(e.getMessage());
		}
		return "Done";
	}

}
