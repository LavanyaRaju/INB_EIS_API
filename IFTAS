	public String  getRequestBodyForGlobalHub(String pPlainMessagePayLoad,String pMessageType,SbiEncResponseModel encryptedResModel){
		String requestBody="";
		
			String encodedEncryptedMsgPayLoad="";
		
			try{
				//GENERATE 32BYTE RANDOM SYMMETRIC KEY 
				byte[] randomSymmKey=glsEncryption.getSymmetricKey();
						//printLogs("getGlobalApiRequestBody","randomSymmKey",Arrays.toString(randomSymmKey));		
				
				//GENERATE 16BYTE IV
				byte[] iv=glsEncryption.getIvSpecification();
						//printLogs("getGlobalApiRequestBody","iv",Arrays.toString(iv));	
				
				//CONCATINATE SYMMETRICKEY AND IV
				byte[] symmKeyWithIv=glsEncryption.combineSymmetricAndIv(randomSymmKey,iv);
						//printLogs("getGlobalApiRequestBody","symmKeyWithIv",Arrays.toString(symmKeyWithIv));	
				
				//ENCRYPT MESSAGE PAYLOAD BODY ---->>ENCRYPT MESSAGE PAYLOAD USING SYMMETRIC KEY,IV AND AUTH KEY(SECRET KEY) 
				byte[] encryptedMsgPayLoad=glsEncryption.getEncryptedMessagePayLoad(pPlainMessagePayLoad,randomSymmKey,iv);
						//printLogs("getGlobalApiRequestBody","encryptedMsgPayLoad",Arrays.toString(encryptedMsgPayLoad));	
				
				//ENCODE THE ENCRYPT MESSAGE PAYLOAD
				encodedEncryptedMsgPayLoad=glsEncryption.getEncoding(encryptedMsgPayLoad);
						//printLogs("getGlobalApiRequestBody","encodedEncryptedMsgPayLoad",encodedEncryptedMsgPayLoad);			
				
				//GENERATE DIGITALE SIGNATURE BY ENCRYPTING HASHED ENCRYPTED PAYLOAD
				String payLoadDigiSign=glsEncryption.getDigitalSignature(encodedEncryptedMsgPayLoad.getBytes());
						//printLogs("getPayLoadHeaderBodt","payLoadDigiSign",payLoadDigiSign);	
				
				//GET ENCRYPTED SYMMETRIC KEY DETAILS 
				String encryptedSymmetricKey=glsEncryption.getEncryptedSymmetrickey(symmKeyWithIv);
						//printLogs("getPayLoadHeaderBodt","encryptedSymmetricKey",encryptedSymmetricKey);
											
				
				//CREATE FINAL REQUEST BODY WITH API HEADER AND MESSAGE BODY 
				requestBody=sbiRequestResponseBodyGen.getNonISOSbiFinalRequestBody(encryptedSymmetricKey,payLoadDigiSign,pMessageType,encodedEncryptedMsgPayLoad,encryptedResModel);						
				
				
				
			}catch(Exception e){
				//printLogs("encryptedMsgPayLoad","Exception",e.getMessage());
				e.printStackTrace();
			}	
			return requestBody;
	}
	
	public  String getDigitalSignatureForISOMessage(String pDocumentTag){
		String isoDigitalSignature="";
		try{
			//GENERATE DIGITALE SIGNATURE BY ENCRYPTING HASHED ENCRYPTED PAYLOAD
			isoDigitalSignature=sign_tag1+glsEncryption.getDigitalSignature(pDocumentTag.getBytes());
					//printLogs("getPayLoadHeaderBodt","payLoadDigiSign",payLoadDigiSign);	
			isoDigitalSignature+="|"+s_Cert_No+"|"+s_Cert_IssuerName+sign_tag2;
			
		}catch(Exception e){
			//printLogs("encryptedMsgPayLoad","Exception",e.getMessage());
			e.printStackTrace();
		}	
		
		return isoDigitalSignature;
	}
	
	public String getDecryptedMessagePayLoad(MessageModel pReceivedMessage) {
		System.out.println("[ GlobalHubReconReportServiceImpl ][getDecryptedMessagePayLoad][ Execution Start   ]");
		String decRequestBody="";
			//ENCRYPTED SYMMETRIC KEY RECEIVED FROM IFTAS
			String encryptedSymmetricKey=pReceivedMessage.getApiHeader().getEncryptedSymmetricKey();
			//System.out.println("encryptedSymmetricKey="+encryptedSymmetricKey);
			
			//SECRETE KEY RECEIVED FROM IFTAS
			String sharedSecreteKey=pReceivedMessage.getApiHeader().getSecretKey();
			
			
			// DECODED PAYLOAD BODY
			byte[] decodeMsgPayLoad=glsEncryption.getDecoding(pReceivedMessage.getEncryptedMessagePayload());
			//DECODED SYMMETRIC KEY
			byte[] decodeSymmKey=glsEncryption.getDecoding(encryptedSymmetricKey);
			
			//DECRYPT SYMMETRIC KEY
			byte[] decryptedSymmetricKeyPayLoad = glsEncryption.decryptSymmKey(decodeSymmKey, sharedSecreteKey);
			//System.out.println("decryptedSymmetricKeyPayLoad ::_ "+Arrays.toString(decryptedSymmetricKeyPayLoad)); 
			
			//DECRYPT MESSAGE PAYLOAD USING RECEIVED SYMMETRIC KEY WITH IV,AND SECRETE KEY 
			byte[] decryptedRequestPayLoad = glsEncryption.decryptResponseMessage(decodeMsgPayLoad, decryptedSymmetricKeyPayLoad, sharedSecreteKey);
			//System.out.println("decryptedRequestPayLoad=="+new String(decryptedRequestPayLoad));
			
			//CONVERT DECRYPTED MESSAGE PAYLOAD TO STRING
			decRequestBody=new String(decryptedRequestPayLoad);
			
			System.out.println("[ GlobalHubReconReportServiceImpl ][getDecryptedMessagePayLoad][ Execution Finished   ]");
		return decRequestBody;
	}
