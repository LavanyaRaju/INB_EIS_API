	public  CLOB getCLOB(String Data,Connection con) throws SQLException{
		
		                 CLOB tempClob = null;
		                 try{
		                	 
		                	// logger.info("Line 1") ;
		                	 
		                             // If the temporary CLOB has not yet been created, create new		                	 
				                	 CallableStatement createTemporaryStmt = con.prepareCall("{ call DBMS_LOB.CREATETEMPORARY(?,TRUE)}");
				                	 

				                	 
				                     createTemporaryStmt.registerOutParameter(1, OracleTypes.CLOB);
				                     createTemporaryStmt.execute();
				                     tempClob =(CLOB) createTemporaryStmt.getObject(1);
				                     
