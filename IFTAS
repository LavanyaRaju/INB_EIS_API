	private boolean getResponseBodyParameters(SbiEncResponseModel encryptedResModel,SbiDecResponseModel pDecryptedResModel,
			BusinessApplicationHeaderV03 pBussMessageHeader, String messagePayLoadReceived, MessageModel  encryptedReqModel) throws SAXException, ParserConfigurationException, IOException, ParseException {

		String refMsgId="",requestBody="",refCreationDateTime="",transTrackId = "",crdtTransTxnsId="",orgMessageDocTag="",modfdMessageDocTag="",cdtrAcctNo="";
		boolean validationResult=false;
		ObjectMapper oMapper = new ObjectMapper();
		
		orgMessageDocTag=messagePayLoadReceived.substring(messagePayLoadReceived.indexOf("<Document"),messagePayLoadReceived.indexOf("</Document>")+11);
		modfdMessageDocTag=orgMessageDocTag.replace(orgMessageDocTag.substring(0,orgMessageDocTag.indexOf(">")+1), "<Document>");
		
		if(pBussMessageHeader.getMsgDefIdr()!=null && !pBussMessageHeader.getMsgDefIdr().equals("") && pBussMessageHeader.getMsgDefIdr().equals("admi.007.001.01") ){
			encryptedResModel.setReceiverId(pReceiver_Id);
		}else{ 
			encryptedResModel.setReceiverId(messagePayLoadReceived.substring(messagePayLoadReceived.indexOf("<MmbId>")+7, messagePayLoadReceived.indexOf("</MmbId>")));
		}
		
		
		if(pBussMessageHeader!=null && pBussMessageHeader.getMsgDefIdr().equalsIgnoreCase("pacs.008.001.11")){
			  requestBody=sbiISOConvUtil.getISOXmlToPojoStringMsg(modfdMessageDocTag,Document.class );
			Document pac008msgBody=oMapper.readValue(requestBody, Document.class);
			refMsgId=pac008msgBody.getFIToFICstmrCdtTrf().getGrpHdr().getMsgId();
			refCreationDateTime=pac008msgBody.getFIToFICstmrCdtTrf().getGrpHdr().getCreDtTm();
			transTrackId = pBussMessageHeader.getBizMsgIdr();
			crdtTransTxnsId=pac008msgBody.getFIToFICstmrCdtTrf().getCdtTrfTxInf().get(0).getPmtId().getTxId();
			System.out.println(" Smitesh crdtTransTxnsId ::"+crdtTransTxnsId);
			String endToEndId=pac008msgBody.getFIToFICstmrCdtTrf().getCdtTrfTxInf().get(0).getPmtId().getEndToEndId();
			if(pac008msgBody.getFIToFICstmrCdtTrf().getCdtTrfTxInf().get(0).getCdtrAcct().getId().getIBAN()!=null){
				cdtrAcctNo=pac008msgBody.getFIToFICstmrCdtTrf().getCdtTrfTxInf().get(0).getCdtrAcct().getId().getIBAN();
			}else{
				cdtrAcctNo=pac008msgBody.getFIToFICstmrCdtTrf().getCdtTrfTxInf().get(0).getCdtrAcct().getId().getOthr().getId();
			}
			
			pDecryptedResModel.setEndToEndId(endToEndId);
			pDecryptedResModel.setCdtTrfTxId(crdtTransTxnsId);
			
			
			System.out.println("Credit Account NO received is ::-"+cdtrAcctNo);
		} else if(pBussMessageHeader!=null && pBussMessageHeader.getMsgDefIdr().equalsIgnoreCase("camt.059.001.07")){
			  requestBody=sbiISOConvUtil.getISOXmlToPojoStringMsg(modfdMessageDocTag,com.sbi.gls.globalApi.models.iso.camt059.Document.class );
			com.sbi.gls.globalApi.models.iso.camt059.Document camt059MsgBody=oMapper.readValue(requestBody, com.sbi.gls.globalApi.models.iso.camt059.Document.class);
			refMsgId=camt059MsgBody.getNtfctnToRcvStsRpt().getGrpHdr().getMsgId();
			refCreationDateTime=camt059MsgBody.getNtfctnToRcvStsRpt().getGrpHdr().getCreDtTm();
			transTrackId = camt059MsgBody.getNtfctnToRcvStsRpt().getOrgnlNtfctnAndSts().getOrgnlMsgId();
		}else if(pBussMessageHeader!=null && pBussMessageHeader.getMsgDefIdr().equalsIgnoreCase("pacs.004.001.12")){
			  requestBody=sbiISOConvUtil.getISOXmlToPojoStringMsg(modfdMessageDocTag,com.sbi.gls.globalApi.models.iso.pacs004.Document.class );
			com.sbi.gls.globalApi.models.iso.pacs004.Document pac004msgBody=oMapper.readValue(requestBody, com.sbi.gls.globalApi.models.iso.pacs004.Document.class);
			refMsgId=pac004msgBody.getPmtRtr().getGrpHdr().getMsgId();
			refCreationDateTime=pac004msgBody.getPmtRtr().getGrpHdr().getCreDtTm();
			transTrackId = pac004msgBody.getPmtRtr().getOrgnlGrpInf().getOrgnlMsgId();//.get(0).getOrgnlTxId();
		}else{
			  requestBody=sbiISOConvUtil.getISOXmlToPojoStringMsg(modfdMessageDocTag,com.sbi.gls.globalApi.models.iso.admi007.Document.class );
			com.sbi.gls.globalApi.models.iso.admi007.Document admi007MsgModel=oMapper.readValue(requestBody, com.sbi.gls.globalApi.models.iso.admi007.Document.class);
			refMsgId=admi007MsgModel.getRctAck().getMsgId().getMsgId();
			//refCreationDateTime=FastDateFormat.getInstance("yyyyMMdd").format(new Date());
			refCreationDateTime=admi007MsgModel.getRctAck().getRpt().get(0).getReqHdlg().getStsDtTm();
			//relationId = admi007MsgModel.getRctAck().getRpt().get(0).getRltdRef().getRef();
			//transactionOriginId = admi007MsgModel.getRctAck().getRpt().get(0).getRltdRef().getRef() ;
			transTrackId=sendMessageDao.fetchOriginTransactionId(admi007MsgModel.getRctAck().getRpt().get(0).getRltdRef().getRef());
			
		}
		
		pDecryptedResModel.setMessageId(sbiGlobalHubTransDao.getSBIMessageId());
		pDecryptedResModel.setRelatedRefNo(pBussMessageHeader.getBizMsgIdr());
		pDecryptedResModel.setRelatedMessageService(pBussMessageHeader.getBizSvc());
		pDecryptedResModel.setTxTrackingId(transTrackId);	
		pDecryptedResModel.setCredAccountNo(cdtrAcctNo);
		
		//VALIDATE REQUEST TO DECIDE WHICH RESPONSE NEED TO SEND (pc004 or camt59 )
		validationResult=validateReceivedMessage(pBussMessageHeader,refMsgId,refCreationDateTime,orgMessageDocTag,pDecryptedResModel);
		
		return validationResult;
		
	}


	private boolean validateReceivedMessage(BusinessApplicationHeaderV03 pBussMessageHeader, String refMsgId,
			String refCreationDateTime, String orgMessageDocTag,SbiDecResponseModel pDecryptedResModel) throws ParseException {
		boolean validationResult;
		String receivedSignDtls[]=pBussMessageHeader.getSgntr().replace("|", "~").split("~");
		String senderPublicKey=sendMessageDao.getSenderCertificateDtls(receivedSignDtls[1],pBussMessageHeader.getFr().getFIId().getFinInstnId().getClrSysMmbId().getMmbId());
		pBussMessageHeader.setSgntr(receivedSignDtls[0]);
		
		ValidationResultModel validationDtls=responseValidator.validateIsoHeaderTag(pBussMessageHeader,senderPublicKey,refMsgId,refCreationDateTime,orgMessageDocTag);
		
		/*ValidationResultModel validationDtls=new ValidationResultModel() ;
		validationDtls.setError_code("S002");
		validationDtls.setError_desc("The message has been received by the destination and successfully validated");
		*/
		
		if(validationDtls!=null && validationDtls.getError_code().equals("S002")){
			pDecryptedResModel.setBusinessService("CBDAcceptedByParticipant");
			pDecryptedResModel.setStatus_code(validationDtls.getError_code());
			pDecryptedResModel.setStatus_desc(validationDtls.getError_desc());
			validationResult=true;
		}else{
			pDecryptedResModel.setBusinessService("CBDRejectedByParticipant");
			pDecryptedResModel.setStatus_code(validationDtls.getError_code());
			pDecryptedResModel.setStatus_desc(validationDtls.getError_desc());
			validationResult=false;
		}
		
		return validationResult;
	}

	
	
	
	
  
	
}
