import oracle.jdbc.OraclePreparedStatement;
import oracle.sql.CLOB;

@Repository
public class SendMessageDaoImpl implements SendMessageDao{

	@Autowired
	private JdbcTemplate jdbcTemplate;
	
	@Autowired
	SbiConverter sbiConverter;
	
	
	@Override
	public boolean insertGhubEncryptedRequest(String pRequestReceived,  MessageModel receivedMsgParam,String pEndPoint) {
		
		try{
			// TODO Auto-generated method stub
			java.sql.Connection con=DataSourceUtils.getConnection(jdbcTemplate.getDataSource());
			
			try {
					CLOB encPayloadClob = sbiConverter.getCLOB(pRequestReceived,con);
				System.out.println("Unique id ::"+receivedMsgParam.getApiHeader().getUniqueID());
				System.out.println("Sender's Id "+receivedMsgParam.getApiHeader().getSenderID());
				System.out.println("Receiver's Id "+receivedMsgParam.getApiHeader().getReceiverID());
				System.out.println("Message payload Type ::"+receivedMsgParam.getApiHeader().getMessagePayLoadType());
				System.out.println("Encrypted Req :: "+encPayloadClob);
				System.out.println("Request received Time Stamp ::"+receivedMsgParam.getApiHeader().getTimeStamp());
				
				
					 OraclePreparedStatement ps = (OraclePreparedStatement)con.prepareStatement(SQLConstant.INSERT_GLOBALHUB_ENCRYPTED_REQUEST);
					 ps.setString(1, receivedMsgParam.getApiHeader().getUniqueID());
					 ps.setString(2, receivedMsgParam.getApiHeader().getSenderID());
					 ps.setString(3, receivedMsgParam.getApiHeader().getReceiverID());
					 ps.setString(4, receivedMsgParam.getApiHeader().getMessagePayLoadType());
					 ps.setCLOB(5, encPayloadClob);
					 ps.setString(6, "G-S");
					 ps.setString(7, receivedMsgParam.getApiHeader().getTimeStamp());
					 ps.setString(8, pEndPoint);
					ps.execute();
